{
  "name": "project-hibernate",
  "private": true,
  "version": "0.1.0",
  "description": "Keep the project. Remove what can be rebuilt.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "test:core": "cargo test -p hibernate-core -p hibernate-cli",
    "cli": "cargo run -q -p hibernate-cli --",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/walkthrough.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npx vite build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "version:bump": "node scripts/bump-version.mjs",
    "smoke:desktop": "bash scripts/smoke-desktop.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "lucide-react": "^0.487.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  }
}
